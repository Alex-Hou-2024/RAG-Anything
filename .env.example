# RAG-Anything FastAPI service configuration
# Copy this file to .env for local development. Do not commit a populated .env.

# HTTP server (run exactly one uvicorn worker; it serves API, frontend, and /lightrag)
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
APP_ENVIRONMENT=production
# Comma-separated public browser origins. Set this to the deployed public URL.
ALLOWED_CORS_ORIGIN=http://localhost:8080

# Required: use a real key only in the runtime environment. The placeholder is rejected at startup.
OPENAI_API_KEY=replace-with-runtime-secret
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1

# Embeddings provider
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# Persistent RAG data. These directories are created at startup; mount them to durable storage in production.
# These canonical RAG_* values are shared by RAG-Anything and LightRAG WebUI.
# Do not configure legacy WORKING_DIR, OUTPUT_DIR, PARSER, or PARSE_METHOD alongside these values.
RAG_WORKING_DIR=./rag_storage
RAG_OUTPUT_DIR=./output
RAG_PARSER=auto
RAG_PARSE_METHOD=auto

# Postgres metadata database (used by subsequent document API work)
DATABASE_URL=postgresql+psycopg://raganything:replace-with-runtime-secret@localhost:5432/raganything

# S3-compatible object storage (used by subsequent document API work)
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=raganything-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-runtime-secret
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-runtime-secret
OBJECT_STORAGE_PREFIX=rag-anything

# Frontend build configuration. Defaults to same-origin /api when unset.
VITE_API_BASE_URL=/api
